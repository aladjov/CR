[run]
source = customer_retention
branch = True
data_file = tests/.coverage
omit =
    */tests/*
    */__pycache__/*
    */site-packages/*
    */__init__.py
    ; Spark/Databricks-only modules — no coverage without PySpark
    */generators/pipeline_generator/databricks_renderer.py
    */generators/pipeline_generator/databricks_generator.py
    */generators/notebook_generator/databricks_generator.py
    */generators/orchestration/databricks_exporter.py
    */integrations/adapters/storage/databricks.py
    */integrations/adapters/feature_store/databricks.py
    */integrations/adapters/mlflow/databricks.py
    */integrations/databricks_init.py
    */stages/modeling/spark_baseline_trainer.py
    */stages/modeling/spark_classifier_wrapper.py
    */stages/modeling/spark_feature_scaler.py
    */stages/profiling/spark_segment_analyzer.py
    */stages/profiling/spark_temporal_feature_analyzer.py
    */stages/profiling/spark_temporal_feature_engineer.py
    */stages/profiling/spark_time_window_aggregator.py
    */stages/temporal/spark_temporal_merger.py
    */core/compat/spark_backend.py
    */transforms/spark_ops.py
    ; Causal track — all Spark-dependent
    */stages/causal/clusterer.py
    */stages/causal/shap_runner.py
    */stages/causal/snapshot_writer.py
    */stages/causal/delta_writer.py
    */stages/causal/dashboard_views.py
    */stages/causal/derivation.py
    */stages/causal/approval_gate.py
    */stages/causal/predicate_compiler.py
    */stages/causal/schemas.py

[report]
precision = 2
show_missing = True
skip_covered = False
skip_empty = True
; fail_under is NOT in pytest.ini — coverage runs only at explicit gates:
;   make test-cov    -> --cov-fail-under=75  (local on-demand)
;   pre-push hook    -> --cov-fail-under=75  (pre-commit)
;   ci.yaml          -> --cov-fail-under=75  (GitHub Actions)

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = tests/htmlcov
